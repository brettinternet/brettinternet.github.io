{
  "name": "brettinternet.github.io",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "biome check assets && git ls-files -z | xargs -0 prettier --check --ignore-unknown && tsc --noEmit",
    "fix": "biome check --write assets && prettier --write ."
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/patua-one": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "giscus": "^1.6.0",
    "mermaid": "^11.16.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "picomatch": "2.3.2",
    "uuid": "14.0.1"
  }
}
